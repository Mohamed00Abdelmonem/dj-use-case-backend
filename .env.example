# Security configuration
SECRET_KEY=change-this-in-production-use-a-strong-random-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,yourdomain.com

# Database configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=use_case_hub
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# CORS & CSRF configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com

# Security Cookies & SSL (Optional, set to True when HTTPS is enabled)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

